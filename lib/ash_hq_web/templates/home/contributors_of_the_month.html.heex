<div class="relative min-h-screen flex justify-center overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-primary-light-900/20 via-primary-dark-900/10 to-primary-light-900/20">
  </div>

  <div class="absolute inset-0 bg-[linear-gradient(rgba(254,19,19,0.2)_1px,transparent_1px),linear-gradient(90deg,rgba(254,19,19,0.2)_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_80%_80%_at_50%_50%,black,transparent)]">
  </div>

  <div class="relative z-10 w-full max-w-5xl px-4 sm:px-6 lg:px-8 mt-36 mb-24">
    <div class="flex justify-center">
      <img class="h-24" src="/images/ash-logo-cropped.svg" alt="" />
    </div>
    <h1 class="text-3xl md:text-4xl font-bold text-center mt-8">
      Contributors of the Month
    </h1>
    <p class="text-xl font-light max-w-3xl mx-auto mt-4 text-center border-b border-b-gray-600 pb-4">
      Each month we recognize folks who have gone
      <span class="text-primary-dark-400">above and beyond</span>
      for the Ash community. Thank you!
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
      <a
        :for={contributor <- @contributors_of_the_month}
        href={"/community/contributors-of-the-month/#{contributor.slug}"}
        class="group flex flex-col items-center text-center rounded-xl border border-slate-500/30 bg-slate-900/60 p-6 hover:border-primary-dark-400 transition-colors"
      >
        <img
          :if={contributor.github}
          class="h-20 w-20 rounded-full ring-2 ring-base-dark-600 group-hover:ring-primary-dark-400 transition-all"
          src={"https://avatars.githubusercontent.com/#{contributor.github}"}
          alt=""
        />
        <div
          :if={!contributor.github}
          class="h-20 w-20 rounded-full ring-2 ring-base-dark-600 group-hover:ring-primary-dark-400 transition-all bg-slate-800 flex items-center justify-center text-2xl font-bold text-primary-dark-400"
        >
          {contributor.name |> String.split() |> Enum.map_join(&String.first/1)}
        </div>
        <span class="mt-4 text-xl font-bold group-hover:text-primary-dark-400 transition-colors">
          {contributor.name}
        </span>
        <span
          :if={month = AshHq.ContributorsOfTheMonth.month_name(contributor)}
          class="text-sm uppercase tracking-widest text-base-light-400 mt-1"
        >
          {month}
        </span>
        <p :if={contributor.reason} class="mt-4 text-sm text-base-light-300 leading-relaxed">
          {contributor.reason}
        </p>
        <span class="mt-auto pt-4 text-sm text-primary-dark-400">View certificate &rarr;</span>
      </a>
    </div>

    <div class="text-center mt-12">
      <a href="/community" class="text-primary-dark-400 hover:underline">
        &larr; Back to the community
      </a>
    </div>
  </div>
</div>
